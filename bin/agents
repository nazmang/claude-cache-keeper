#!/usr/bin/env python3
"""agents - live Claude Code sessions on this machine, and prompt-cache upkeep.

  agents status [--json [--max-age S]]
                                all live sessions: status, idle time, cache left,
                                context, model, tmux window. --json adds people
                                (people.conf) and the checklist summary; with
                                --max-age, a cached answer younger than S seconds
                                is reused (the agents-panel mod polls this)
  agents messages [--hours H]   messages between sessions (SendMessage) in the last
                                H hours (6 by default); ❄ marks a message that woke a
                                recipient whose prompt cache had already expired
  agents compact-idle [--dry-run]
                                compact sessions whose cache is about to expire
                                (idle 53..59 min; the cache-keeper mod inside a
                                session fires at 50), if they run in tmux, are
                                idle, have an empty input box and an uncompacted
                                context above MIN_CTX tokens
  agents compact <name> [--wait]
                                compact one session now (same checks except idle
                                time); --wait - wait until done (exit 0 = done)
  agents up <project> [name...]   start a project's sessions in tmux
  agents down <project> [name...] [--no-compact]
                                compact and close them (--no-compact: just close,
                                e.g. before a clean restart with up --fresh)

Projects come from two files:
  ~/.config/agents/projects.conf  "project | dir | up command | down command" -
                                  a team with its own start/stop scripts; names
                                  are passed to them as arguments
  ~/.config/agents/sessions.conf  "project | name | dir | model | session id [| extra args]" -
                                  plain sessions, one per line. `up` opens each in
                                  tmux session <project>, window <name>, with
                                  `claude -n <name> --resume <id>`. Empty model =
                                  your default. Empty id = a new session; its id is
                                  written back, so the next `up` resumes it.
                                  A session already running (in tmux or not) is
                                  left alone. `down` closes only idle sessions
                                  with an empty input box, compacting first.
                                  `up --fresh` ignores the stored id and starts a
                                  new session (a nightly clean start); extra args
                                  go to claude as written (e.g. --remote-control
                                  Duty "start the shift").

Why: the prompt cache lives 1 hour from the last request. A session that wakes
up after an hour of idling writes its whole context into the cache again at
full price. /compact at minute 50-59 still reads the context from the cache
(cheap) and leaves a small summary, so the next wake-up costs next to nothing.

People: ~/.config/agents/people.conf, "session name | display name | f|m|-".
Checklist snapshot: ~/.local/state/agents/checklist/items/*.json, one JSON per item
  ({id, data: {project, title, who, status, ...}}), as written by an artifact
  database dump; "waiting on you" = open items whose `who` is in OWNER_WHO.
Log: ~/.local/state/agents/compact-idle.log
Env: COMPACT_FROM, COMPACT_TO (minutes), MIN_CTX (tokens).
"""
import json, os, re, shlex, subprocess, sys, time, glob, uuid
from datetime import datetime, timezone

SESSIONS_DIR = os.path.expanduser("~/.claude/sessions")
PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
CONF = os.path.expanduser("~/.config/agents/projects.conf")
SESS_CONF = os.path.expanduser("~/.config/agents/sessions.conf")
PEOPLE_CONF = os.path.expanduser("~/.config/agents/people.conf")
CHECKLIST_DIR = os.path.expanduser("~/.local/state/agents/checklist/items")
STATUS_CACHE = os.path.expanduser("~/.local/state/agents/status.json")
OWNER_WHO = set(os.environ.get("OWNER_WHO", "владелец,вместе,ты,owner,together,you").split(","))
LOG = os.path.expanduser("~/.local/state/agents/compact-idle.log")
CACHE_TTL = 60
COMPACT_FROM = int(os.environ.get("COMPACT_FROM", 53))  # the cache-keeper mod compacts at 50; this is the fallback
COMPACT_TO = int(os.environ.get("COMPACT_TO", 59))
MIN_CTX = int(os.environ.get("MIN_CTX", 60000))
TAIL_BYTES = 4 * 1024 * 1024


# "shell": the turn is over but a background command (Monitor, a server) runs.
# The session takes input like an idle one.
IDLE_STATES = ("idle", "shell")


def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    line = f"{datetime.now().isoformat(timespec='seconds')} {msg}"
    with open(LOG, "a") as f:
        f.write(line + "\n")
    print(line)


def tmux(*args):
    r = subprocess.run(["tmux", *args], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def tmux_panes():
    """pane_pid -> ("=session:index", "session:name"); target by index, names may repeat."""
    out = {}
    for line in tmux("list-panes", "-a", "-F",
                     "#{pane_pid}\t#{session_name}\t#{window_index}\t#{window_name}").splitlines():
        pid, s, wi, wn = line.split("\t")
        out[int(pid)] = (f"={s}:{wi}", f"{s}:{wn}")
    return out


def ancestors(pid):
    seen = []
    for _ in range(10):
        seen.append(pid)
        try:
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
        except Exception:
            break
        if pid <= 1:
            break
    return seen


def transcript_info(sid):
    """(time of last reply, context tokens, compacted since then, model, last tool)."""
    paths = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{sid}.jsonl"))
    if not paths:
        return None, 0, False, "", ""
    p = paths[0]
    size = os.path.getsize(p)
    with open(p, "rb") as f:
        f.seek(max(0, size - TAIL_BYTES))
        lines = f.read().decode("utf-8", "replace").splitlines()
    last_ts, ctx, model, compacted_after = None, 0, "", False
    tool = ""   # the newest assistant entry: its tool_use name, or "" for text/thinking
    for line in reversed(lines):
        if '"type":"assistant"' not in line:
            continue
        try:
            content = (json.loads(line).get("message") or {}).get("content") or []
        except Exception:
            continue
        uses = [c.get("name", "") for c in content if isinstance(c, dict) and c.get("type") == "tool_use"]
        tool = uses[-1] if uses else ""
        break
    for line in reversed(lines):
        if '"compact_boundary"' in line and last_ts is None and not compacted_after:
            compacted_after = True
            try:  # idle counts from the compaction, not from the reply before it
                bts = datetime.fromisoformat(json.loads(line)["timestamp"].replace("Z", "+00:00"))
            except Exception:
                bts = None
        if '"type":"assistant"' not in line:
            continue
        try:
            d = json.loads(line)
        except Exception:
            continue
        msg = d.get("message") or {}
        u = msg.get("usage") or {}
        if not u:
            continue
        last_ts = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00"))
        if compacted_after and bts:
            last_ts = bts
        ctx = sum(u.get(k, 0) for k in ("input_tokens", "cache_read_input_tokens",
                                        "cache_creation_input_tokens"))
        model = msg.get("model", "")
        break
    return last_ts, ctx, compacted_after, model, tool


def sessions():
    panes = tmux_panes()
    out = []
    for f in glob.glob(os.path.join(SESSIONS_DIR, "*.json")):
        try:
            d = json.load(open(f))
        except Exception:
            continue
        pid = d.get("pid")
        if not pid or not os.path.exists(f"/proc/{pid}") or d.get("kind") != "interactive":
            continue
        target = label = None
        for a in ancestors(pid):
            if a in panes:
                target, label = panes[a]
                break
        last, ctx, compacted, model, tool = transcript_info(d.get("sessionId", ""))
        try:  # --model on the command line wins: right after a restart there are no replies yet
            argv = open(f"/proc/{pid}/cmdline", "rb").read().decode().split("\0")
            if "--model" in argv:
                model = argv[argv.index("--model") + 1]
        except Exception:
            pass
        idle = (datetime.now(timezone.utc) - last).total_seconds() / 60 if last else None
        out.append(dict(name=d.get("name") or f"(pid {pid})", pid=pid, sid=d.get("sessionId"),
                        cwd=d.get("cwd", ""), status=d.get("status", ""), target=target,
                        label=label, idle=idle, ctx=0 if compacted else ctx, model=model, tool=tool))
    return sorted(out, key=lambda s: (s["label"] or "~", s["name"]))


def input_empty(target):
    screen = tmux("capture-pane", "-e", "-p", "-t", target)
    lines = [l for l in screen.splitlines() if "❯" in l]
    if not lines:
        return False
    rest = lines[-1].split("❯", 1)[1].replace("\xa0", " ")
    if "\x1b[2m" in rest:          # dim placeholder text = empty
        return True
    return re.sub(r"\x1b\[[0-9;]*m|\s", "", rest) == ""


def do_compact(s, dry):
    why = None
    if not s["target"]:
        why = "not in tmux"
    elif s["status"] not in IDLE_STATES:
        why = f"status {s['status']}"
    elif not input_empty(s["target"]):
        why = "input box has a draft"
    if why:
        log(f"skip  {s['name']}: {why}")
        return False
    if dry:
        log(f"dry   {s['name']}: would compact ({s['ctx']//1000}k, idle {s['idle']:.0f} min)")
        return True
    tmux("send-keys", "-t", s["target"], "-l", "/compact")
    time.sleep(0.5)
    tmux("send-keys", "-t", s["target"], "Enter")
    log(f"sent  {s['name']}: /compact ({s['ctx']//1000}k, idle {s['idle']:.0f} min, {s['label']})")
    return True


def cmd_status():
    print(f"{'session':28} {'status':7} {'idle':>8} {'cache':>7} {'context':>9}  model / window")
    for s in sessions():
        idle = f"{s['idle']:.0f}m" if s["idle"] is not None else "—"
        if s["idle"] is None:
            cache = "—"
        else:
            left = CACHE_TTL - s["idle"]
            cache = f"{left:.0f}m" if left > 0 else "expired"
        ctx = f"{s['ctx']//1000}k" if s["ctx"] else "compact"
        model = s["model"].replace("claude-", "")
        print(f"{s['name'][:28]:28} {s['status']:7} {idle:>8} {cache:>7} {ctx:>9}  {model} / {s['label'] or 'no tmux'}")


def people():
    out = {}
    for parts in conf_lines(PEOPLE_CONF):
        parts += ["", ""]
        out[parts[0]] = {"display": parts[1] or parts[0], "gender": parts[2] or "-"}
    return out


def checklist():
    files = glob.glob(os.path.join(CHECKLIST_DIR, "*.json"))
    if not files:
        return None
    items = []
    for f in files:
        try:
            d = json.load(open(f))
        except Exception:
            continue
        data = d.get("data") or d
        if data.get("status") not in ("todo", None):
            continue
        items.append({"id": d.get("id") or os.path.basename(f)[:-5],
                      "project": data.get("project", ""), "title": data.get("title", ""),
                      "who": data.get("who", ""), "section": data.get("section", ""),
                      "order": data.get("order", 0)})
    items.sort(key=lambda i: (i["project"], i["order"]))
    waiting = [i for i in items if i["who"] in OWNER_WHO]
    return {"snapshot": max(os.path.getmtime(f) for f in files),
            "open": len(items), "waiting": waiting}


def project_of(s):
    if s["label"]:
        return s["label"].split(":", 1)[0]
    return os.path.basename(s["cwd"].rstrip("/")) or "?"


def transcript_tail(sid):
    paths = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{sid}.jsonl"))
    if not paths:
        return []
    with open(paths[0], "rb") as f:
        f.seek(max(0, os.path.getsize(paths[0]) - TAIL_BYTES))
        return f.read().decode("utf-8", "replace").splitlines()


def ts_of(d):
    return datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00"))


def messages(hours=6, live=None):
    """SendMessage calls of live sessions: newest first, with cold-wake marks."""
    live = live if live is not None else sessions()
    by_pid = {s["pid"]: s for s in live}
    by_name = {s["name"]: s for s in live}
    since = datetime.now(timezone.utc).timestamp() - hours * 3600
    replies = {}      # sid -> sorted timestamps of the session's own replies
    out = []
    for s in live:
        own = []
        for line in transcript_tail(s["sid"]):
            if '"type":"assistant"' not in line:
                continue
            try:
                d = json.loads(line)
            except Exception:
                continue
            if d.get("isSidechain"):
                continue
            t = ts_of(d).timestamp()
            own.append(t)
            if t < since or '"SendMessage"' not in line:
                continue
            for c in (d.get("message") or {}).get("content") or []:
                if not (isinstance(c, dict) and c.get("type") == "tool_use" and c.get("name") == "SendMessage"):
                    continue
                inp = c.get("input") or {}
                to = str(inp.get("to", ""))
                m = re.search(r"/(\d+)\.sock$", to)
                target = by_pid.get(int(m.group(1))) if m else by_name.get(to)
                text = inp.get("summary") or str(inp.get("message", "")).split("\n")[0]
                to_name = target["name"] if target else ("(closed session)" if m else to)
                out.append({"ts": t, "from": s["name"], "to": to_name,
                            "to_sid": target["sid"] if target else None, "text": text[:160]})
        replies[s["sid"]] = sorted(own)
    for m in out:
        own = replies.get(m.pop("to_sid"), [])
        before = [t for t in own if t <= m["ts"]]
        m["cold"] = bool(before) and (m["ts"] - before[-1]) / 60 > CACHE_TTL
    out.sort(key=lambda m: m["ts"], reverse=True)
    return out


def cmd_messages(hours):
    for m in messages(hours):
        when = datetime.fromtimestamp(m["ts"]).strftime("%H:%M")
        print(f"{when} {'❄' if m['cold'] else ' '} {m['from'][:22]:22} → {m['to'][:22]:22} {m['text'][:90]}")


def cmd_status_json(max_age):
    if max_age:
        try:
            if time.time() - os.path.getmtime(STATUS_CACHE) < max_age:
                sys.stdout.write(open(STATUS_CACHE).read())
                return
        except OSError:
            pass
    ppl = people()
    now = datetime.now(timezone.utc)
    rows = []
    live = sessions()
    for s in live:
        p = ppl.get(s["name"], {})
        rows.append({
            "name": s["name"], "display": p.get("display", s["name"]),
            "gender": p.get("gender", "-"), "project": project_of(s),
            "status": s["status"], "model": s["model"].replace("claude-", ""),
            "idle_min": None if s["idle"] is None else round(s["idle"], 1),
            "cache_min": None if s["idle"] is None else round(CACHE_TTL - s["idle"], 1),
            "ctx": s["ctx"], "tmux": s["label"], "target": s["target"], "pid": s["pid"],
            "tool": s["tool"]})
    ppl_display = {k: v["display"] for k, v in ppl.items()}
    msgs = [{**m, "from": ppl_display.get(m["from"], m["from"]), "to": ppl_display.get(m["to"], m["to"])}
            for m in messages(6, live)[:12]]
    out = json.dumps({"at": now.isoformat(timespec="seconds"), "sessions": rows,
                      "checklist": checklist(), "messages": msgs}, ensure_ascii=False)
    os.makedirs(os.path.dirname(STATUS_CACHE), exist_ok=True)
    tmp = STATUS_CACHE + f".{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(out)
    os.replace(tmp, STATUS_CACHE)
    sys.stdout.write(out)


def cmd_compact_idle(dry):
    n = 0
    for s in sessions():
        if s["idle"] is None or not (COMPACT_FROM <= s["idle"] < COMPACT_TO):
            continue
        if s["ctx"] < MIN_CTX:
            continue
        n += do_compact(s, dry)
    return n


def boundary_after(sid, since):
    """Is there a compact_boundary in the transcript newer than since (unix time)."""
    paths = glob.glob(os.path.join(PROJECTS_DIR, "*", f"{sid}.jsonl"))
    if not paths:
        return False
    with open(paths[0], "rb") as f:
        f.seek(max(0, os.path.getsize(paths[0]) - TAIL_BYTES))
        for line in reversed(f.read().decode("utf-8", "replace").splitlines()):
            if '"compact_boundary"' in line:
                try:
                    ts = json.loads(line)["timestamp"].replace("Z", "+00:00")
                    return datetime.fromisoformat(ts).timestamp() > since
                except Exception:
                    return False
    return False


def compact_wait(s):
    """Compact a session and wait until done. True = compacted or nothing to do."""
    since = time.time() - 1

    # "Not enough messages" never reaches the transcript - count it on screen
    def nothing_to_do():
        if not s["target"]:
            return 0
        return tmux("capture-pane", "-p", "-S", "-200", "-t", s["target"]).count(
            "Not enough messages to compact")
    before = nothing_to_do()
    if not do_compact(s, False):
        return False
    # Done = a new compact_boundary in the transcript. The screen is no
    # proof: an old "Compacted" line from a previous run may still be
    # visible there (that once got a session restarted mid-compaction).
    for _ in range(120):
        if boundary_after(s["sid"], since):
            log(f"done  {s['name']}: compacted")
            return True
        if nothing_to_do() > before:
            log(f"done  {s['name']}: nothing to compact (Not enough messages)")
            return True
        time.sleep(5)
    log(f"FAIL  {s['name']}: compaction did not finish in 10 min")
    return False


def cmd_compact(name, wait):
    for s in sessions():
        if s["name"] == name:
            return compact_wait(s) if wait else do_compact(s, False)
    print(f"no live session '{name}'")
    return False


def conf_lines(path):
    if not os.path.exists(path):
        return []
    out = []
    for line in open(path):
        line = line.split("#", 1)[0].strip()
        if line:
            out.append([p.strip() for p in line.split("|")])
    return out


def team_project(name):
    for parts in conf_lines(CONF):
        if parts[0] == name and len(parts) >= 4:
            return parts
    return None


def session_lines(name, names):
    rows = [p + [""] * (6 - len(p)) for p in conf_lines(SESS_CONF) if p[0] == name]
    if names:
        rows = [r for r in rows if r[1] in names]
    return rows


def save_session_id(project, name, sid):
    lines = open(SESS_CONF).read().splitlines(keepends=True)
    for i, line in enumerate(lines):
        parts = [p.strip() for p in line.split("#", 1)[0].split("|")]
        if len(parts) >= 2 and parts[0] == project and parts[1] == name:
            parts += [""] * (6 - len(parts))
            parts[4] = sid
            lines[i] = " | ".join(parts[:5] + ([parts[5]] if parts[5] else [])) + "\n"
    with open(SESS_CONF, "w") as f:
        f.writelines(lines)


def sessions_up(project, rows, fresh=False):
    live = {s["sid"]: s for s in sessions()}
    for _, name, d, model, sid, extra in rows:
        if fresh and sid in live:
            print(f"  = {name}: running - `agents down {project}` first")
            continue
        if fresh:
            sid = ""
        if sid and sid in live:
            s = live[sid]
            print(f"  = {name}: already running (pid {s['pid']}, {s['label'] or 'no tmux'})")
            continue
        args = ["claude", "-n", name]
        if model and model != "-":
            args += ["--model", model]
        if sid:
            args += ["--resume", sid]
        else:
            sid = str(uuid.uuid4())
            args += ["--session-id", sid]
            save_session_id(project, name, sid)
        if extra:
            args += shlex.split(extra)
        # A tmux server keeps the environment it was started with; drop
        # CLAUDE* so the new session does not think it runs inside another one.
        cmd = "for v in ${!CLAUDE@}; do unset $v; done; exec " + " ".join(shlex.quote(a) for a in args)
        d = os.path.expanduser(d)
        if subprocess.run(["tmux", "has-session", "-t", f"={project}"], capture_output=True).returncode:
            tmux("new-session", "-d", "-s", project, "-n", name, "-c", d, "bash", "-c", cmd)
        else:
            tmux("new-window", "-d", "-t", f"={project}:", "-n", name, "-c", d, "bash", "-c", cmd)
        print(f"  + {name}: started in tmux {project}:{name} ({'resume ' + sid if '--resume' in args else 'new ' + sid})")
    return 0


def sessions_down(project, rows, compact=True):
    wanted = {r[4] for r in rows if r[4]}
    rc = 0
    for s in sessions():
        if s["sid"] not in wanted:
            continue
        if not s["target"]:
            print(f"  ! {s['name']}: not in tmux - close it yourself (/compact, then /exit)")
            rc = 1
            continue
        if compact and s["ctx"] >= MIN_CTX and not compact_wait(s):
            print(f"  ! {s['name']}: not closed, compaction failed or session busy")
            rc = 1
            continue
        if not type_command(s, "/exit"):
            rc = 1
            continue
        for _ in range(30):
            if not os.path.exists(f"/proc/{s['pid']}"):
                break
            time.sleep(1)
        print(f"  - {s['name']}: closed (resume id {s['sid']})")
    return rc


def type_command(s, text):
    """Type a command into an idle session with an empty input box."""
    if s["status"] not in IDLE_STATES or not input_empty(s["target"]):
        print(f"  ! {s['name']}: busy or input box has a draft - skipped")
        return False
    tmux("send-keys", "-t", s["target"], "-l", text)
    time.sleep(0.5)
    tmux("send-keys", "-t", s["target"], "Enter")
    return True


def cmd_updown(which, name, names):
    team = team_project(name)
    if team:
        _, d, up, down = team[:4]
        cmd = up if which == "up" else down
        env = {k: v for k, v in os.environ.items() if not k.startswith("CLAUDE")}
        return subprocess.run(["bash", "-c", f'{cmd} "$@"', "_", *names],
                              cwd=os.path.expanduser(d), env=env).returncode
    fresh = "--fresh" in names
    compact = "--no-compact" not in names
    names = [n for n in names if n not in ("--fresh", "--no-compact")]
    rows = session_lines(name, names)
    if not rows:
        sys.exit(f"no project '{name}' in {CONF} or {SESS_CONF}")
    return sessions_up(name, rows, fresh) if which == "up" else sessions_down(name, rows, compact)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); return 0
    c = argv[0]
    if c == "status" and "--json" in argv:
        age = float(argv[argv.index("--max-age") + 1]) if "--max-age" in argv else 0
        cmd_status_json(age)
    elif c == "status":
        cmd_status()
    elif c == "messages":
        cmd_messages(float(argv[argv.index("--hours") + 1]) if "--hours" in argv else 6)
    elif c == "compact-idle":
        cmd_compact_idle("--dry-run" in argv)
    elif c == "compact" and len(argv) >= 2:
        return 0 if cmd_compact(argv[1], "--wait" in argv) else 1
    elif c in ("up", "down") and len(argv) >= 2:
        return cmd_updown(c, argv[1], argv[2:])
    else:
        print(__doc__); return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
