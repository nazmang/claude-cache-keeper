[Unit]
Description=Run agents compact-idle every 2 minutes

[Timer]
OnBootSec=2min
# The compaction window is 53-59 min (6 min wide). The interval must be well
# below that: OnUnitActiveSec counts from activation and drifts by run time plus
# AccuracySec. With 5 min and a 4-min window a session once slipped through.
OnUnitActiveSec=2min
AccuracySec=5s

[Install]
WantedBy=timers.target
